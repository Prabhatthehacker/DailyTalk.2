# Website (copy to web/.env.local). Firebase web config values are NOT secrets,
# but access is controlled by database.rules.json.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
# Realtime Database address, shown in Firebase > Realtime Database > Data (starts with https://)
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
# Optional: GIF picker (https://developers.giphy.com)
VITE_GIPHY_API_KEY=
# Optional: calls across restrictive networks need a TURN server
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Optional: photos/videos upload to catbox.moe by default (max 200 MB). Set these only if you deploy the proxy in worker/.
VITE_UPLOAD_URL=
VITE_MAX_UPLOAD_MB=200
# Optional: asset base path. "./" works for GitHub Pages project sites and any static host.
VITE_BASE=./

# Android: put the equivalents in android/local.properties (never committed) or
# pass as -P Gradle properties / CI secrets:
#   GIPHY_API_KEY, UPLOAD_URL, MAX_UPLOAD_MB, TURN_URL, TURN_USERNAME, TURN_CREDENTIAL
